@{
    ViewData["Title"] = "Home Page";
}

<form method="post" action="/home/compose">
    <div class="lCol">
        <textarea class="score" id="rtttl" name="rtttl" spellcheck="false">8e2 8#d2 8e2 8#d2 8e2 8b1 8d2 8c2 4a1 8- 8c1 8e1 8a1 4b1 8- 8e1 8#g1 8b1 4c2 8- 8e1 8e2 8#d2 8e2 8#d2 8e2 8b1 8d2 8c2 4a1 8- 8c1 8e1 8a1 4b1 8- 8e1 8c2 8b1 4a1</textarea>
    </div>
    <div class="rCol">
        <h1>Nokia Ringtone Composer</h1>
        <input type="submit" value="Play" id="play" name="play" />
        <input type="submit" value="Download" id="download" name="download" />
    </div>
</form>

@section Scripts {
    <script type="text/javascript">

    function playHandler(event) {
        event.preventDefault();
        const input = document.querySelector("#rtttl");
        const rtttl = input.value;
        const bpm = new URLSearchParams(window.location.search).get('bpm');
        fetch("/Home/Compose", {
            method: "POST",
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ rtttl, bpm }),
        }).then((response) => {
            if (!response.ok) {
                throw new Error(`HTTP error! Status: ${response.status}`);
            }

            return response.json();
        }).then(play);
    }
    
    function downloadHandler(event) {
        event.preventDefault();
        const input = document.querySelector("#rtttl");
        const rtttl = input.value;
        const bpm = new URLSearchParams(window.location.search).get('bpm');
        fetch("/Home/Download/", {
            method: "POST",
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ rtttl, bpm }),
        }).then((response) => {
            if (!response.ok) {
                throw new Error(`HTTP error! Status: ${response.status}`);
            }
            return response.blob();
        }).then((blob) => {
            var file = window.URL.createObjectURL(blob);
            window.location.assign(file);
        })
        .catch((error) => console.log(error));
    }
    
    document.querySelector("#play").addEventListener("click", playHandler);
    document.querySelector("#download").addEventListener("click", downloadHandler);
    
    function play(composition) {
        const audioCtx = new AudioContext();
        const oscillator = audioCtx.createOscillator();
        oscillator.type = "square";
        
        let start = audioCtx.currentTime;
        let elapsed = 0;
        for (let token of composition.tokens) {
            oscillator.frequency.setValueAtTime(token.frequencyHz, start + elapsed);
            elapsed += token.duractionSeconds;
        }
        oscillator.frequency.setValueAtTime(0, start + elapsed);
        oscillator.connect(audioCtx.destination);
        oscillator.start();
    }
    
</script>
}